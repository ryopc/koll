{
  "name": "koll-phone",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build:frontend": "vite build",
    "build": "npm run build:frontend && wrangler deploy --dry-run",
    "deploy": "npm run build:frontend && wrangler deploy",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "db:create": "wrangler d1 create koll-phone-db",
    "db:migrate:local": "wrangler d1 migrations apply koll-phone-db --local",
    "db:migrate:prod": "wrangler d1 migrations apply koll-phone-db"
  },
  "dependencies": {
    "hono": "^4.6.0",
    "bcryptjs": "^2.4.3",
    "jose": "^5.9.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241004.0",
    "@types/bcryptjs": "^2.4.6",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vite-plugin-pwa": "^0.20.0",
    "wrangler": "^3.80.0"
  }
}